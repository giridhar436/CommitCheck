# ——————————————————————————————————————————————————
# CommitCheck Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# ——————————————————————————————————————————————————

# RUNTIME connection to Supabase PostgreSQL (pooled through Supabase pgBouncer).
# Supabase Dashboard → Project Settings → Database → Connection string → "Transaction" mode.
# The pgbouncer + connection_limit params are required for the pooled port (6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT connection (no pooler) — used only by Prisma Migrate, which needs DDL
# and shadow-database privileges that the pooled port does not allow.
# Supabase Dashboard → Project Settings → Database → Connection string → "Direct connection".
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# HTTP port for the NestJS app
PORT=3000

# ——— Phase 15: Supabase Auth (REQUIRED — the API refuses to start without it) ———
# Every route requires a Supabase Auth HS256 access token. The backend verifies
# it with this secret (Dashboard → Project Settings → API → JWT Secret).
# Missing/blank = startup aborts with a clear error. Never expose to the frontend.
SUPABASE_JWT_SECRET=

# ——— Phase 15: Supabase Admin API (server-side only) ———
# Used by the members endpoints to resolve an email → Supabase Auth user id.
# SUPABASE_URL is the project URL (https://<ref>.supabase.co); the service-role
# key is never logged, never returned by any endpoint, and never sent to the
# frontend. Leave unset to disable member addition (a clear 400 explains why).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ——— Phase 15: email notifications (optional; server-side only) ———
# When RESEND_API_KEY and RESEND_FROM are both set, lifecycle notifications
# (HIGH-risk unauthorized commitments, change-request created/approved/rejected/
# clarification) are emailed via Resend. Otherwise notifications are recorded in
# the notification_log table only (dev-safe default). The API key is never
# logged or returned; provider failures never affect the triggering transaction.
RESEND_API_KEY=
RESEND_FROM=

# AI analysis provider selection (Phase 8). The only bundled implementation
# is the deterministic development provider ("development"), which runs a
# rule-based extraction locally and refuses to run in production. When a
# production AI provider lands, register it under its own value here.
MEETING_ANALYSIS_PROVIDER=development

# ——— Phase 9: Fireworks AI provider (server-side only — never expose to the frontend) ———
# Paste your Fireworks API key here (https://fireworks.ai → API keys) and NEVER
# commit the filled-in .env. Used only when MEETING_ANALYSIS_PROVIDER=fireworks.
FIREWORKS_API_KEY=
# Chat model used for meeting analysis. Optional — this default is used when unset.
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2-instruct

# ——— Phase 14: embedding provider (server-side only — never expose to the frontend) ———
# 'openai' enables semantic indexing against any OpenAI-compatible vendor.
# Leave EMBEDDING_PROVIDER unset to run with indexing disabled: chunks are kept
# unindexed (SKIPPED) and retrieval uses deterministic lexical ranking. There is
# deliberately NO fake/offline embedding mode.
EMBEDDING_PROVIDER=
# Secret — never logged, never returned by any endpoint.
EMBEDDING_API_KEY=
# Model + dimensions. Default text-embedding-3-small (1536 dims).
EMBEDDING_MODEL=text-embedding-3-small
# Any OpenAI-compatible endpoint works (request/response shape must match).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_MS=20000

# ——— Phase 14: optional server-side document download (Supabase Storage) ———
# When set, POST /documents/:id/process without textContent/binaryContent can
# download the PDF/DOCX bytes from Supabase Storage. All three variables are
# required together; the service key is used only server-side and is never
# returned, logged, or included in error messages.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_BUCKET=documents
SUPABASE_STORAGE_SERVICE_KEY=
