// ——————————————————————————————————————————————————————————————————————————
// CommitCheck — Database Schema (Phase 1: database foundation)
// ——————————————————————————————————————————————————————————————————————————
// Business flow:
//   Project → Approved Scope → Meeting → Commitment Detection
//   → Scope Verification → Unauthorized Commitment → Change Request
//   → Approval → Execution
//
// Conventions:
//   • UUID primary keys generated database-side (gen_random_uuid(), PG13+)
//   • snake_case table/column names via @map (clean interop with Supabase
//     SQL editor, RLS policies, and future pgvector columns)
//   • Referential integrity: full cascade down the derivation chain —
//     deleting a Project removes its entire graph; deleting a Meeting
//     removes its attachments and detected commitments.
// ——————————————————————————————————————————————————————————————————————————

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgBouncer) — app runtime
  directUrl = env("DIRECT_URL") // direct — Prisma Migrate / shadow DB
}

// ————————————————————————————————————————————————————————————————
// Enums
// ————————————————————————————————————————————————————————————————

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  AUTHORIZED
  UNAUTHORIZED
  PENDING
}

enum MeetingAnalysisStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CLARIFICATION_REQUESTED
}

enum DocumentType {
  SOW
  CONTRACT
  PROPOSAL
  REQUIREMENTS
  OTHER
}

/// Deterministic text-extraction lifecycle (Phase 13). PROCESSING exists for
/// a future async pipeline; the current endpoint processes synchronously.
enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Per-chunk embedding state (Phase 14). SKIPPED = no embedding provider is
/// configured (retrieval stays deterministic/lexical for that chunk);
/// FAILED = the provider call failed after the chunk itself was extracted.
/// pgvector is NOT used (see README) — embeddings, when present, are plain
/// float arrays persisted as JSON and compared in-process (brute force).
enum ChunkEmbeddingStatus {
  SKIPPED
  PENDING
  COMPLETED
  FAILED
}

enum EvidenceSource {
  TRANSCRIPT
  SUMMARY
  NOTES
  RECORDING
  DOCUMENT
  OTHER
}

/// Project-level role (Phase 15 RBAC). OWNER > ADMIN > MEMBER > VIEWER.
/// Approval actions (change requests, scope authorization) require ADMIN+;
/// VIEWER is read-only. A user's role is stored per project in project_members.
enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Delivery state of one notification attempt (Phase 15).
/// FAILED is auditable but never blocks/corrupts the business transaction.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  SCOPE_UPDATED
  SCOPE_REQUIREMENT_CREATED
  SCOPE_REQUIREMENT_UPDATED
  SCOPE_REQUIREMENT_DELETED
  DOCUMENT_UPLOADED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_PROCESSED
  DOCUMENT_PROCESSING_FAILED
  MEETING_CREATED
  MEETING_UPDATED
  MEETING_DELETED
  MEETING_ANALYZED
  MEETING_ATTACHMENT_CREATED
  MEETING_ATTACHMENT_UPDATED
  MEETING_ATTACHMENT_DELETED
  COMMITMENT_CREATED
  COMMITMENT_UPDATED
  COMMITMENT_DELETED
  COMMITMENT_VERIFIED
  EVIDENCE_ADDED
  EVIDENCE_DELETED
  COMMITMENT_DETECTED
  COMMITMENT_FLAGGED
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_APPROVED
  CHANGE_REQUEST_REJECTED
  CHANGE_REQUEST_CANCELLED
  CHANGE_REQUEST_CLARIFICATION_REQUESTED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

enum ActivityEntityType {
  PROJECT
  SCOPE_REQUIREMENT
  MEETING
  MEETING_ATTACHMENT
  COMMITMENT
  CHANGE_REQUEST
  DOCUMENT
}

// ————————————————————————————————————————————————————————————————
// Models
// ————————————————————————————————————————————————————————————————

/// A client engagement whose approved scope is monitored for creep.
/// `ownerUserId` is the Supabase Auth user id (uuid string, NO FK — the
/// identity lives in Supabase's `auth` schema, which this database must not
/// reference). Nullable only for legacy rows created before Phase 15; every
/// project created through the API gets it set transactionally with an OWNER
/// membership row.
model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  clientName  String        @map("client_name")
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  budget      Decimal?      @db.Decimal(12, 2)
  ownerUserId String?       @map("owner_user_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  scopeRequirements ScopeRequirement[]
  meetings          Meeting[]
  commitments       Commitment[]
  changeRequests    ChangeRequest[]
  documents         Document[]
  activities        Activity[]
  members           ProjectMember[]
  notifications     NotificationLog[]

  @@index([status])
  @@index([ownerUserId])
  @@map("projects")
}

/// Per-project membership + role (Phase 15 RBAC). `userId` is a Supabase
/// Auth user id (no FK to the auth schema). Access enforcement is centralized
/// in ProjectAccessService; every project-scoped query derives the user's
/// membership through this table.
model ProjectMember {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(VIEWER)
  /// Email resolved from Supabase Auth when the member is added — used by
  /// notification providers to address the member without querying the
  /// auth schema at send time. May be null for legacy/implicit rows.
  email     String?     @db.VarChar(320)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// One row per notification event (Phase 15): the unique `eventKey` makes
/// sending idempotent (a duplicate event is skipped, not re-sent). Failures
/// are recorded here — observable and auditable — and never propagate into
/// the business transaction that triggered the notification.
model NotificationLog {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventKey        String             @unique @map("event_key") @db.VarChar(191)
  type            String             @db.VarChar(100)
  projectId       String             @map("project_id") @db.Uuid
  entityType      String?            @map("entity_type") @db.VarChar(50)
  entityId        String?            @map("entity_id") @db.Uuid
  recipientUserId String?            @map("recipient_user_id") @db.Uuid
  recipientEmail  String?            @map("recipient_email") @db.VarChar(320)
  provider        String             @db.VarChar(50)
  status          NotificationStatus @default(PENDING)
  error           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("notification_log")
}

/// A single requirement that is part of a project's approved scope.
/// `sourceDocumentId` (Phase 13) optionally traces it back to the project
/// document it came from; manual/seeded requirements leave it null and
/// keep working unchanged.
model ScopeRequirement {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String         @map("project_id") @db.Uuid
  title              String
  description        String?        @db.Text
  category           String
  priority           Priority       @default(MEDIUM)
  approvalStatus     ApprovalStatus @default(PENDING) @map("approval_status")
  sourceClause       String?        @map("source_clause")
  acceptanceCriteria String?        @map("acceptance_criteria") @db.Text
  sourceDocumentId   String?        @map("source_document_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([projectId, approvalStatus])
  @@index([projectId, priority])
  @@index([sourceDocumentId])
  @@map("scope_requirements")
}

/// A client meeting whose transcript/notes are analyzed for commitments.
model Meeting {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String                @map("project_id") @db.Uuid
  title          String
  summary        String?               @db.Text
  meetingDate    DateTime              @map("meeting_date")
  analysisStatus MeetingAnalysisStatus @default(NOT_STARTED) @map("analysis_status")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments MeetingAttachment[]
  commitments Commitment[]

  @@index([projectId, meetingDate(sort: Desc)])
  @@index([projectId, analysisStatus])
  @@map("meetings")
}

/// A file (transcript, notes, recording, screenshot) attached to a meeting.
model MeetingAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  fileName    String   @map("file_name")
  fileType    String?  @map("file_type")
  storagePath String   @map("storage_path")
  fileSize    Int?     @map("file_size")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_attachments")
}

/// A promise detected during a meeting, verified against the approved scope.
model Commitment {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String         @map("project_id") @db.Uuid
  meetingId           String         @map("meeting_id") @db.Uuid
  title               String
  description         String?        @db.Text
  speaker             String?
  riskLevel           RiskLevel      @default(LOW) @map("risk_level")
  authorizationStatus ApprovalStatus @default(PENDING) @map("authorization_status")
  confidenceScore     Float?         @map("confidence_score")
  evidenceReference   String?        @map("evidence_reference")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meeting        Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  evidence       CommitmentEvidence[]
  changeRequests ChangeRequest[]

  @@index([projectId, authorizationStatus])
  @@index([projectId, riskLevel])
  @@index([meetingId, authorizationStatus])
  @@map("commitments")
}

/// A verbatim quote that evidences when/how a commitment was made.
model CommitmentEvidence {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commitmentId String         @map("commitment_id") @db.Uuid
  quote        String         @db.Text
  timestamp    DateTime?
  source       EvidenceSource @default(TRANSCRIPT)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@index([commitmentId])
  @@map("commitment_evidence")
}

/// A formal request to authorize work that a commitment introduced outside scope.
model ChangeRequest {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  commitmentId   String              @map("commitment_id") @db.Uuid
  title          String
  description    String?             @db.Text
  status         ChangeRequestStatus @default(PENDING)
  approvalReason String?             @map("approval_reason") @db.Text
  clarificationComment String?       @map("clarification_comment") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitment Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([commitmentId])
  @@map("change_requests")
}

/// A project document (SOW, contract, proposal) whose binary lives in Supabase
/// Storage (metadata-only — no storage I/O in the API, same as meeting
/// attachments). `processingStatus` tracks the deterministic text-extraction
/// lifecycle; extracted text lives in the 1:1 DocumentText table.
model Document {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String                   @map("project_id") @db.Uuid
  title            String
  type             DocumentType
  storagePath      String                   @map("storage_path")
  fileSize         Int?                     @map("file_size")
  processingStatus DocumentProcessingStatus @default(PENDING) @map("processing_status")
  processedAt      DateTime?                @map("processed_at")
  processingError  String?                  @map("processing_error")
  uploadedAt       DateTime                 @default(now()) @map("uploaded_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  extractedText      DocumentText?
  chunks             DocumentChunk[]
  sourceRequirements ScopeRequirement[]

  @@index([projectId, type])
  @@map("documents")
}

/// Deterministically extracted plain text for a document (Phase 13).
/// 1:1 with Document, cascade-deleted with it; content is normalized
/// (BOM stripped, line endings unified) so reprocessing is idempotent.
model DocumentText {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @unique @map("document_id") @db.Uuid
  content    String   @db.Text
  charCount  Int      @map("char_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_texts")
}

/// Deterministic chunk of a document's normalized text (Phase 14).
/// Rebuilt in full on every processing run (delete + recreate inside one
/// transaction, keyed by (documentId, chunkIndex)) — retries never duplicate.
/// charStart/charEnd are offsets into the document's normalized DocumentText.
/// contentHash (sha-256 of the chunk text) lets unchanged chunks reuse their
/// stored embedding instead of re-calling the provider.
model DocumentChunk {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String               @map("document_id") @db.Uuid
  chunkIndex      Int                  @map("chunk_index")
  text            String               @db.Text
  charStart       Int                  @map("char_start")
  charEnd         Int                  @map("char_end")
  contentHash     String               @map("content_hash") @db.VarChar(64)
  embeddingStatus ChunkEmbeddingStatus @default(SKIPPED) @map("embedding_status")
  embedding       Json?
  embeddingModel  String?              @map("embedding_model")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([contentHash])
  @@map("document_chunks")
}

/// Audit-log entry: an immutable trail of what happened inside a project.
/// entityId is a polymorphic UUID reference (no FK) to the row named by entityType.
model Activity {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String             @map("project_id") @db.Uuid
  action      ActivityAction
  entityType  ActivityEntityType @map("entity_type")
  entityId    String?            @map("entity_id") @db.Uuid
  description String             @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([action])
  @@map("activities")
}
