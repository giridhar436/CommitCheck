# ==============================================================================
# CommitCheck Production & Development Environment Configuration
# Production URL: https://commit-check.vercel.app
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Supabase PostgreSQL via Prisma) - REQUIRED IN VERCEL
# ------------------------------------------------------------------------------
# Application connection string (pooled through PgBouncer/Supavisor, port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432) used for Prisma schema migrations & CLI
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Application Base URL & Session Security - REQUIRED IN VERCEL
# ------------------------------------------------------------------------------
# Canonical public application URL (used for OAuth redirects, Svix webhooks & email links)
# Production: https://commit-check.vercel.app
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://commit-check.vercel.app"

# Cryptographic HMAC session signing key (minimum 32 characters)
AUTH_SECRET="your_high_entropy_32_character_session_secret_here"

# ------------------------------------------------------------------------------
# 3. GitHub OAuth (Freelancer Auth & Repo Binding) - REQUIRED IN VERCEL
# Callback URL: https://commit-check.vercel.app/api/auth/github
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID="your_github_oauth_client_id_here"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret_here"

# ------------------------------------------------------------------------------
# 4. Google OAuth (Client Auth) - REQUIRED IN VERCEL
# Callback URL: https://commit-check.vercel.app/api/auth/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret_here"

# ------------------------------------------------------------------------------
# 5. Linear OAuth & Workspace Sync - REQUIRED IN VERCEL FOR LIVE LINEAR SYNC
# Callback URL: https://commit-check.vercel.app/api/auth/linear/callback
# ------------------------------------------------------------------------------
LINEAR_CLIENT_ID="your_linear_oauth_client_id_here"
LINEAR_CLIENT_SECRET="your_linear_oauth_client_secret_here"

# ------------------------------------------------------------------------------
# 6. Recall.ai Meeting Bot Infrastructure - REQUIRED IN VERCEL FOR LIVE BOT
# Webhook URL: https://commit-check.vercel.app/api/webhooks/recall
# ------------------------------------------------------------------------------
RECALL_AI_API_KEY="your_recall_ai_api_key_here"
# Regional API host (default: https://api.recall.ai, or region e.g. https://ap-northeast-1.recall.ai)
RECALL_API_BASE_URL="https://api.recall.ai"
RECALL_REGION="us-east-1"
# Svix signing secret from your Recall.ai dashboard webhook endpoint (must start with whsec_)
RECALL_WEBHOOK_SECRET="whsec_your_svix_signing_secret_here"

# ------------------------------------------------------------------------------
# 7. Google Gemini AI Extraction & Verification Engine - REQUIRED IN VERCEL
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 8. Resend Stakeholder Email Service - REQUIRED IN VERCEL FOR LIVE EMAIL
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"
# Must be an address on a verified sender domain (e.g. notifications@yourdomain.com)
RESEND_FROM_EMAIL="CommitCheck <notifications@your-verified-domain.com>"
