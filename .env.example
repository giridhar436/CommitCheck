# ——————————————————————————————————————————————————
# CommitCheck — Environment Configuration
# Copy this file to .env and fill in values
# ——————————————————————————————————————————————————

# API Mode: "mock" (in-memory demo data) or "remote" (NestJS backend)
VITE_API_MODE=mock

# Backend API base URL (only used when VITE_API_MODE=remote)
VITE_API_URL=http://localhost:3000/api

# Application name (used in page titles)
VITE_APP_NAME=CommitCheck

# ——— Supabase Auth (Phase 15) ———
# Identity source for sign-in/sign-up. The ANON key is safe for the browser;
# service-role keys must NEVER be placed in frontend env files.
# Leave empty to run the UI with an explicit "authentication not configured" state.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
