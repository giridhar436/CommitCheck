# Environment Variables for CommitCheck

# Database (Supabase PostgreSQL)
# Pooled connection string (via PgBouncer/Supavisor, port 6543) used by the application runtime
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct connection string (port 5432) used for Prisma schema migrations and CLI commands
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Application URL & Auth Secret
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="commitcheck-super-secure-session-auth-token-key-2026"

# GitHub OAuth (Freelancer Auth & Repo Binding)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (Client Auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Linear OAuth (Freelancer Project Sync)
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""

# Recall.ai Meeting Bot Infrastructure
RECALL_AI_API_KEY=""
# Svix signing secret from the Recall.ai dashboard webhook endpoint (whsec_...)
RECALL_WEBHOOK_SECRET=""

# Gemini AI Extraction & Verification Engine
GEMINI_API_KEY=""

# Resend Email Notification
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
