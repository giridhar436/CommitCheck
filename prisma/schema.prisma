datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FREELANCER
  CLIENT
}

enum RequirementClassification {
  EXPLICIT
  AI_INFERRED
  TENTATIVE
  CONFIRMED_COMMITMENT
}

enum ClientApprovalStatus {
  NOT_REQUIRED
  PENDING_CLIENT_APPROVAL
  CLIENT_APPROVED
  CLIENT_REJECTED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  avatarUrl           String?
  role                Role
  githubId            String?   @unique
  githubUsername      String?
  githubAccessToken   String?
  googleId            String?   @unique
  linearAccessToken   String?
  linearRefreshToken  String?
  linearWorkspaceId   String?
  linearWorkspaceName String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  freelancerProjects  Project[] @relation("FreelancerProjects")
  clientProjects      Project[] @relation("ClientProjects")
}

model Project {
  id                 String        @id @default(cuid())
  name               String
  title              String?
  description        String?
  clientEmail        String?
  githubRepo         String
  githubRepoFullName String?
  status             String        @default("ACTIVE")
  linearProjectId    String?
  linearProjectUrl   String?
  linearTeamId       String?
  freelancerId       String
  clientId           String?
  freelancer         User          @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: Cascade)
  client             User?         @relation("ClientProjects", fields: [clientId], references: [id], onDelete: SetNull)
  meetings           Meeting[]
  auditReports       AuditReport[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Meeting {
  id             String            @id @default(cuid())
  projectId      String
  meetUrl        String
  botId          String?
  recallBotId    String?
  status         String            @default("SCHEDULED")
  transcript     String?
  transcriptJson String?
  analysisJson   String?
  analyzedAt     DateTime?
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskDrafts     LinearTaskDraft[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model LinearTaskDraft {
  id                   String                    @id @default(cuid())
  meetingId            String
  projectId            String?
  title                String
  description          String
  status               String                    @default("DRAFT")
  classification       RequirementClassification @default(EXPLICIT)
  clientApprovalStatus ClientApprovalStatus      @default(NOT_REQUIRED)
  evidence             String?
  confidence           Float?
  suggestedMilestone   String?
  priority             Int                       @default(0)
  estimate             Int?
  linearIssueId        String?
  linearIssueKey       String?
  linearIssueUrl       String?
  meeting              Meeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @default(now()) @updatedAt
}

model AuditReport {
  id                 String   @id @default(cuid())
  projectId          String
  status             String   @default("COMPLETED")
  auditorRole        String   @default("FREELANCER_SELF_CHECK") // "CLIENT" | "FREELANCER_SELF_CHECK"
  summary            String
  verifiedPercentage Float
  verifiedTasksJson  String   @default("[]")
  discrepanciesJson  String   @default("[]")
  ghostCompletions   Int      @default(0)
  untrackedCommits   Int      @default(0)
  latestCommitSha    String?
  triggeredById      String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}
