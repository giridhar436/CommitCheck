datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FREELANCER
  CLIENT
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  avatarUrl           String?
  role                Role
  githubId            String?   @unique
  githubUsername      String?
  githubAccessToken   String?
  googleId            String?   @unique
  linearAccessToken   String?
  linearWorkspaceId   String?
  linearWorkspaceName String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  freelancerProjects  Project[] @relation("FreelancerProjects")
  clientProjects      Project[] @relation("ClientProjects")
}

model Project {
  id              String        @id @default(cuid())
  name            String
  githubRepo      String
  linearProjectId String?
  freelancerId    String
  clientId        String?
  freelancer      User          @relation("FreelancerProjects", fields: [freelancerId], references: [id], onDelete: Cascade)
  client          User?         @relation("ClientProjects", fields: [clientId], references: [id], onDelete: SetNull)
  meetings        Meeting[]
  auditReports    AuditReport[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Meeting {
  id          String            @id @default(cuid())
  projectId   String
  meetUrl     String
  botId       String?
  status      String            @default("SCHEDULED")
  transcript  String?
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskDrafts  LinearTaskDraft[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model LinearTaskDraft {
  id          String   @id @default(cuid())
  meetingId   String
  title       String
  description String
  status      String   @default("STAGED")
  priority    Int      @default(0)
  estimate    Int?
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model AuditReport {
  id                 String   @id @default(cuid())
  projectId          String
  status             String   @default("COMPLETED")
  summary            String
  verifiedPercentage Float
  discrepanciesJson  String
  ghostCompletions   Int      @default(0)
  untrackedCommits   Int      @default(0)
  triggeredById      String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}
